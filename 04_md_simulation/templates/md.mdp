; Production MD template

integrator              = md
dt                      = 0.001
nsteps                  = 200000000

cutoff-scheme           = Verlet
nstlist                 = 10
pbc                     = xyz

coulombtype             = PME
rcoulomb                = 1.0
fourierspacing          = 0.12
pme-order               = 4
ewald-rtol              = 1e-5

vdwtype                 = Cut-off
vdw-modifier            = Potential-shift
rvdw                    = 1.0
DispCorr                = EnerPres

constraints             = h-bonds
constraint-algorithm    = lincs
lincs-order             = 4
lincs-iter              = 1

tcoupl                  = V-rescale
tc-grps                 = Enzyme Water_and_ions
tau-t                   = 0.2 0.2
ref-t                   = 298.15 298.15

pcoupl                  = Parrinello-Rahman
pcoupltype              = isotropic
tau-p                   = 1.0
ref-p                   = 1.0
compressibility         = 4.5e-5

comm-mode               = Linear
comm-grps               = System
nstcomm                 = 100

continuation            = yes
gen-vel                 = no

nstxout                 = 0
nstvout                 = 0
nstfout                 = 0
nstcalcenergy           = 100
nstenergy               = 1000
nstlog                  = 5000
nstxout-compressed      = 1000
compressed-x-grps       = System
compressed-x-precision  = 1000
