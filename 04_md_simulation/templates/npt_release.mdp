; Unrestrained NPT equilibration template

integrator              = md
cutoff-scheme           = Verlet
nstlist                 = 20
pbc                     = xyz

coulombtype             = PME
rcoulomb                = 1.0
fourierspacing          = 0.12
pme-order               = 4
ewald-rtol              = 1e-5

vdwtype                 = Cut-off
vdw-modifier            = Potential-shift
rvdw                    = 1.0
DispCorr                = EnerPres

constraints             = h-bonds
constraint-algorithm    = lincs
lincs-order             = 4
lincs-iter              = 1

tcoupl                  = V-rescale
tc-grps                 = System
tau-t                   = 1.0
ref-t                   = 298.15

comm-mode               = Linear
comm-grps               = System
nstcomm                 = 100

nstxout                 = 0
nstvout                 = 0
nstfout                 = 0
compressed-x-grps       = System
compressed-x-precision  = 1000

define                  =
dt                      = 0.002
nsteps                  = 500000
continuation            = yes
gen-vel                 = no

pcoupl                  = Parrinello-Rahman
pcoupltype              = isotropic
tau-p                   = 5.0
ref-p                   = 1.0
compressibility         = 4.5e-5

nstcalcenergy           = 100
nstenergy               = 500
nstlog                  = 500
nstxout-compressed      = 500
