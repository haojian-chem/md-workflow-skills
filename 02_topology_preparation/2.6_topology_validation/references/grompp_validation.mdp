; Preset used only for gmx grompp during topology validation.
; It is not an energy-minimization or MD protocol, and the generated .tpr
; must not be used as a simulation input.
;
; No topology preprocessor macro is enabled by this file.
; Periodic boundary conditions are disabled so that this check does not require
; the periodic box that will be constructed in the later system-construction stage.
;
; Non-bonded cut-offs and neighbor-list updates are disabled. These settings are
; used only to preprocess and inspect the current structure/topology association;
; they do not define the later simulation protocol.

integrator                  = steep
nsteps                      = 0
emtol                       = 1000.0
emstep                      = 0.01

constraints                 = none

cutoff-scheme               = Verlet
pbc                         = no
nstlist                     = 0
verlet-buffer-tolerance     = -1
rlist                       = 0

coulombtype                 = Cut-off
rcoulomb                    = 0

vdwtype                     = Cut-off
rvdw                        = 0
DispCorr                    = no
